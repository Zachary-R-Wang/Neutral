# Copy this file to .env and fill in your key.  .env is gitignored and never committed.
#
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-...

# --- Which models the evaluation uses -------------------------------------------------
# SUBJECT is the model being measured for bias. Changing it changes the experiment.
# JUDGE scores the answers. It is deliberately a different model from SUBJECT, so the
# judge is not grading its own work.
NEUTRAL_SUBJECT_MODEL=claude-opus-5
NEUTRAL_JUDGE_MODEL=claude-sonnet-5

# --- How the measurement is run -------------------------------------------------------
# Runs per variant. Minimum 5: below that, model randomness cannot be separated from
# real divergence.
NEUTRAL_RUNS_PER_VARIANT=5
NEUTRAL_CONCURRENCY=8

# --- S5: no persistence of personal data by default -----------------------------------
# Leave unset. Setting it to true writes identifying data to disk.
AUDIT_RETAIN=false
AUDIT_RETENTION_HOURS=24
